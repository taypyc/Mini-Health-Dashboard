{
  "name": "mini-health-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "mcp-server"
  ],
  "scripts": {
    "build:mcp": "npm run build --prefix mcp-server",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:mcp && npm run build:backend && npm run build:frontend",
    "dev:mcp": "npm run build --prefix mcp-server",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
